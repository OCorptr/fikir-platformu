# Frontend build-time environment variables.
# .env.development (gitignored) veya .env.production (gitignored) dosyasına kopyala.
#
# VITE_API_BASE_URL:
#   - BOŞ (veya yok): API çağrıları relative (/api/...) olur.
#     Nginx/IIS reverse proxy backend'i /api'ye yönlendirir (same-domain deploy).
#     ÖNERİLEN: aynı domain + reverse proxy.
#   - Tam URL: cross-origin deployment (frontend ile backend farklı domain).
#     Örn: VITE_API_BASE_URL=https://api.fikir.meb.gov.tr
#     Backend'de Cors:AllowedOrigins listesine bu domain EKLENMELI.
VITE_API_BASE_URL=