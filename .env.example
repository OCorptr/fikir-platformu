# Fikir Platformu — YEĞİTEK production .env örneği
# Bu dosyayı `.env` olarak kopyala ve gerçek değerlerle doldur.

# ===== Veritabanı =====
# YEĞİTEK'in kendi MySQL sunucusu varsa:
DB_CONNECTION_STRING="Server=mysql.yegitek.gov.tr;Port=3306;Database=fikir_platformu;User=fikir_app;Password=CHANGE_ME;SslMode=Preferred;"

# Eğer docker-compose ile gelen MySQL'i kullanıyorsan:
# DB_CONNECTION_STRING="Server=mysql;Port=3306;Database=fikir_platformu;User=fikir;Password=FikirGuclu2026!;SslMode=Preferred;"

# ===== MySQL container (sadece docker compose --profile with-mysql ile) =====
MYSQL_ROOT_PASSWORD="RootGuclu2026!"
MYSQL_DATABASE="fikir_platformu"
MYSQL_USER="fikir"
MYSQL_PASSWORD="FikirGuclu2026!"

# ===== Frontend API base URL =====
# nginx reverse proxy kullanıyorsan BOŞ bırak (relative /api/*).
# Cross-origin deployment (farklı domain) için absolute URL ver.
# Örnek: VITE_API_BASE_URL="https://fikir-api.yegitek.gov.tr"
VITE_API_BASE_URL=""

# ===== CORS (cross-origin ise) =====
# Same-origin nginx'te BOŞ bırak. Cross-origin'de virgülle ayrılmış origin listesi:
# Örnek: CORS_ALLOWED_ORIGINS="https://fikir.yegitek.gov.tr,https://admin.yegitek.gov.tr"
CORS_ALLOWED_ORIGINS=""

# ===== E-posta (şifre sıfırlama + e-posta doğrulama + MFA Email OTP) =====
# 3 mod var — birini seç:
#
# MOD 1 — RESEND HTTPS API (önerilen, Render/SAAS için garantili):
#   SMTP port 25/465/587 Render tarafından bloklanabilir.
#   Resend HTTPS port 443 kullanır, port kısıtı yok. Gmail App Password da yok.
MAIL__TYPE="resend"                              # bu mod için şart
MAIL__PASS="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"       # Resend API key
MAIL__FROM="onboarding@resend.dev"               # test için hazır sender
MAIL__FROMNAME="Geleceğin Fikri"
#
# Kurulum (2dk):
#   1) https://resend.com/signup → "Continue with GitHub"
#   2) API Keys → Create → "Sending access" → KEY'I KOPYALA
#   3) MAIL__PASS'e yapıştır, MAIL__FROM'u kendi domain'e değiştir (opsiyonel)
#
# MOD 2 — SMTP (Gmail / Outlook / SendGrid klasik yöntem):
#   SMTP port bloklaması varsa çalışmayabilir.
#   MAIL__HOST="smtp.gmail.com"
#   MAIL__PORT="587"
#   MAIL__USER="fikirplatformu@gmail.com"
#   MAIL__PASS="abcdefghijklmnop"      # Gmail App Password (boşluksuz 16 hane)
#   MAIL__FROM="fikirplatformu@gmail.com"
#   MAIL__FROMNAME="Geleceğin Fikri"
#
# MOD 3 — BOŞ bırakılırsa:
#   DevelopmentEmailSender devreye girer (log + dosya — sadece demo).
