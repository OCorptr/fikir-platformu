<Project>
  <!-- Backend çözümündeki tüm projeler için ortak ayarlar (Docker build dahil). -->
  <!-- TargetFramework açıkça set edilmeli — Microsoft.NET.Sdk.Web default TargetFramework vermez,
       bazı SDK sürümlerinde (örn Render.com .NET 10.0.401) inference başarısız olur. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>